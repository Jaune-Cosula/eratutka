# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_RESTORE_SECRET: seals the hunt restore token (AES-256-GCM). Must be stable
# across restarts and instances, so that a hunt survives a Cloud Run scale-to-zero or a
# deploy. Falls back to GATEWAY_SECRET when unset; with neither set, restore is disabled
# and hunts are lost whenever the server restarts.
SESSION_RESTORE_SECRET=""
