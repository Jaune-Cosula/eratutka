rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's private saved dogs & markers
      match /dogs/{dogId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /mapAnnotations/{markerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Hunt sessions are capability-protected: the document ID *is* the session's
    // secret hunt key (16 random bytes as 32 hex characters, generated by the server
    // in POST /api/session/create). Knowing the ID is the authorization, so the rules
    // cannot and need not verify a separate password here.
    //
    //   * get     - allowed, but only for capability-shaped IDs.
    //   * list    - DENIED, so nobody can enumerate or discover session IDs.
    //   * write   - allowed for capability-shaped IDs (same capability model).
    //   * delete  - DENIED, so an attacker cannot destroy a shared hunt's state.
    //
    // The ID length check also makes the old pre-2026 sessions unreachable: those were
    // keyed by human codes like "HIRVI-4821", which are shorter than 32 characters.
    match /sessions/{sessionId} {
      allow get: if sessionId.size() == 32;
      allow list: if false;
      allow create, update: if sessionId.size() == 32;
      allow delete: if false;
    }
  }
}
